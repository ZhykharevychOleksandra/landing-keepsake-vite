section.section.clients
  .container
    h2.section-title Clients &amp; kind words
    p.section-desc Some of the teams that trusted us with their brands.
    ul.client-logos
      each client in clientLogos
        li.client-logo(class=client.modifier) #{ client.name }
    blockquote.testimonial
      span.quote-mark(aria-hidden='true') “
      p.testimonial-text Keepsake turned a vague brief into a brand we are proud of. The team was fast, honest about trade-offs and obsessed with the details.
      footer.testimonial-author
        .author-info
          span.author-avatar(aria-hidden='true') OM
          div
            cite.author-name Olena Marchenko
            p.author-role Marketing Lead, Nordly
        .slider-dots(aria-hidden='true')
          span.dot.active
          span.dot
          span.dot
