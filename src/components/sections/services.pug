section#services.section.services
  .container
    h2.section-title What do we do
    p.section-desc We are a small team of designers and makers who help brands look their best online and offline.
    .services-grid
      each service in services
        article.service-card
          .service-icon-bg
            +icon(service.icon)
          h3.service-title #{ service.title }
          p.service-text #{ service.text }
    .stats-grid
      each stat in stats
        .stat-item
          p.stat-number #{ stat.number }
          p.stat-label #{ stat.label }
